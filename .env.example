# Copy to .env.local for local development. Never commit real values.
# Each block lists the plan step/feature that starts using it (see plan/tech-stack.md).

# --- Clerk (S5) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
# Our own sign-in page — server-side redirects (auth.protect) use this. Not secret.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in

# --- Supabase (S6) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (bypasses RLS): only the Clerk webhook route and scripts/ use it — never pages or Server Actions.
SUPABASE_SECRET_KEY=
# Bootstrap roles for `pnpm users:sync` (local only, not needed on Vercel). Format:
# email=role+role; email=role   — roles: admin, requester, it_operator, approver, auditor
ROLE_BOOTSTRAP=

# --- Browser tests (S7d, `pnpm test:e2e`) ---
# Test users in the Clerk *dev* instance (+clerk_test = no emails, code 424242),
# with MFA set up once. In CI these are GitHub Actions variables.
E2E_ADMIN_EMAIL=
E2E_APPROVER_EMAIL=
# Their authenticator keys ("Can't scan? Enter the key manually" on /session-tasks).
# In CI: GitHub Actions + Dependabot secrets.
E2E_ADMIN_TOTP_SECRET=
E2E_APPROVER_TOTP_SECRET=

# --- AI assistant (F15) ---
AI_PROVIDER=
AI_MODEL=
ANTHROPIC_API_KEY=

# --- Email (F23) ---
RESEND_API_KEY=

# --- SharePoint via Microsoft Graph (F22) ---
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
SHAREPOINT_SITE_ID=
SHAREPOINT_FOLDER_ID=

# --- Error monitoring (R3) ---
SENTRY_DSN=
