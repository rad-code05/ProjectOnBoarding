# Copy to .env.local for local development. Never commit real values.
# Each block lists the plan step/feature that starts using it (see plan/tech-stack.md).

# --- Clerk (S5) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
# Our own sign-in page — server-side redirects (auth.protect) use this. Not secret.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in

# --- Supabase (S6) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Service role / secret key: scripts and migrations only, never used in request code.
SUPABASE_SECRET_KEY=

# --- AI assistant (F15) ---
AI_PROVIDER=
AI_MODEL=
ANTHROPIC_API_KEY=

# --- Email (F23) ---
RESEND_API_KEY=

# --- SharePoint via Microsoft Graph (F22) ---
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
SHAREPOINT_SITE_ID=
SHAREPOINT_FOLDER_ID=

# --- Error monitoring (R3) ---
SENTRY_DSN=
